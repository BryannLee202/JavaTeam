# Base URL of the backend API (BFF). Example: https://api.seal-hackathon.fpt.edu.vn
VITE_API_BASE_URL=http://localhost:8080/api

# Set to "false" once the real backend endpoints below are ready.
# While "true", the app runs entirely on in-memory mock data (src/api/mockData.ts)
# so P4/P6 can develop against this UI without waiting on the backend.
VITE_USE_MOCK=true
