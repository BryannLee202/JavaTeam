# =============================================================================
# Bien moi truong cho frontend
# =============================================================================
# LUU Y: hien tai frontend dung HAI bien base URL khac nhau cho hai nua ung dung.
# Day khong phai thiet ke co chu dinh — no la hau qua cua viec hai nguoi dung
# len hai lop goi API rieng. Chua gop lam mot vi sap den buoi demo, gop lai la
# dung vao file dung chung cua ca nhom. Ghi ro ra day de khong ai set nham.
# =============================================================================

# --- 1. VITE_BFF_URL ---------------------------------------------------------
# Doc boi src/api/client.ts (axios).
# Dung cho: trang cong khai (Landing, Voting, Ranking), man cham diem,
#           "Doi cua toi", cac tab Tieu chi / Giai thuong / Xu ly vi pham.
# Tro vao BFF, KHONG tro thang vao backend — BFF giu access token trong cookie
# httpOnly roi moi chuyen tiep xuong Spring Boot kem Bearer token.
VITE_BFF_URL=http://localhost:4000

# --- 2. VITE_API_BASE_URL ----------------------------------------------------
# Doc boi src/api/http.ts (fetch).
# Dung cho: eventsApi — bon tab Su kien / Hang muc / Vong thi / Doi thi trong
#           khu dieu phoi.
# Chi co tac dung khi VITE_USE_MOCK=false. Mac dinh trong code la "/api".
VITE_API_BASE_URL=http://localhost:4000/api

# --- 3. VITE_USE_MOCK --------------------------------------------------------
# "true"  (mac dinh): bon tab khu dieu phoi chay bang du lieu gia trong
#                     src/api/mockData.ts, khong can backend.
# "false": bon tab do goi API that.
#
# Buoi demo dang chay voi gia tri "true". Luu y: chi eventsApi nghe bien nay.
# Trang cong khai, cham diem va "Doi cua toi" LUON goi backend that du bien nay
# bang gi. Du lieu mau trong backend/src/main/resources/data-demo.sql da duoc
# dat trung ten voi mockData.ts de hai nua hien cung mot noi dung.
VITE_USE_MOCK=true
